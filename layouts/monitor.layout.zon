// pimon hardware monitor, styled after a radial-gauge dashboard.
//
//   ./pimon-fb --layout layouts/monitor.layout.zon
//
// Every number below is LIVE: `bind_value` / `bind_data` refer to keys the app
// publishes each frame from /proc (see dashboard.publishLive):
//   cpu.load_pct  cpu.load1/5/15  cpu.count  cpu.temp  cpu.temp_max
//   ram.used_mb   ram.total_mb    ram.used_pct   cpu.load_hist
//
// `gauge` also understands a static `.value = 22.4` when no bind is given.
// `sparkline` likewise accepts a static `.data = .{ 1.0, 2.0, ... }`.

.{
    .component = .vbox,
    .expand = .both,
    .padding = 8,
    .children = .{

        .{ .component = .title, .text = "pimon monitor" },
        .{ .component = .separator },

        .{
            .component = .hbox,
            .expand = .both,
            .children = .{

                // ---- CPU -------------------------------------------------
                .{
                    .component = .vbox,
                    .expand = .both,
                    .children = .{
                        .{ .component = .heading, .text = "CPU" },
                        .{
                            .component = .hbox,
                            .children = .{
                                // load
                                .{
                                    .component = .vbox,
                                    .children = .{
                                        .{ .component = .label, .text = "LOAD %  (1 min)" },
                                        .{ .component = .gauge, .bind_value = "cpu.load_pct", .max = 100.0, .unit = "%", .color = "green" },
                                        .{ .component = .label, .text = "history (48 s)" },
                                        .{ .component = .sparkline, .bind_data = "cpu.load_hist", .color = "cyan", .height = 44.0 },
                                        .{ .component = .label, .text = "load  1m / 5m / 15m" },
                                    },
                                },
                                // temp
                                .{
                                    .component = .vbox,
                                    .children = .{
                                        .{ .component = .label, .text = "TEMP" },
                                        .{ .component = .gauge, .bind_value = "cpu.temp", .max = 80.0, .unit = "°C", .color = "orange" },
                                        .{ .component = .label, .text = "full scale 80 °C" },
                                    },
                                },
                            },
                        },
                    },
                },

                // ---- RAM -------------------------------------------------
                .{
                    .component = .vbox,
                    .expand = .both,
                    .children = .{
                        .{ .component = .heading, .text = "RAM" },
                        .{ .component = .label, .text = "usage (%)" },
                        .{ .component = .gauge, .bind_value = "ram.used_pct", .max = 100.0, .unit = "%", .color = "lime" },
                        .{ .component = .label, .text = "static demo series" },
                        .{
                            .component = .sparkline,
                            .color = "blue",
                            .height = 44.0,
                            .data = .{ 3.0, 5.0, 2.0, 8.0, 6.0, 9.0, 4.0, 7.0, 11.0, 6.0, 9.0, 13.0, 8.0, 10.0 },
                        },
                    },
                },
            },
        },

        .{ .component = .separator },
        .{
            .component = .hbox,
            .children = .{
                .{ .component = .label, .text = "Live values are published from /proc each frame." },
                .{ .component = .spacer, .width = 12 },
                .{ .component = .button, .text = "Reload layout", .action = "reload_layout" },
                .{ .component = .spacer, .width = 12 },
                .{ .component = .button, .text = "Quit", .action = "quit" },
            },
        },
    },
}
